{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter interfaces/api/express dev",
    "dev:web": "pnpm --filter app-next dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "mono-build": "pnpm tsc -b tsconfig.build.json",
    "mysql:seed": "pnpm --filter infrastructure run mysql:seed",
    "mysql:restart": "pnpm --filter infrastructure run mysql:restart",
    "mongo:seed": "pnpm --filter infrastructure run mongo:seed",
    "mongo:restart": "pnpm --filter infrastructure run mongo:restart",
    "socket": "pnpm --filter sockets run socket",
    "express": "pnpm --filter express run express"
  },
  "workspaces": [
    "application",
    "domain",
    "infrastructure",
    "interfaces/*"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter app-next dev",
    "build:domain": "pnpm --filter domain build",
    "build:app": "pnpm --filter application build",
    "build:infra": "pnpm --filter infrastructure build",
    "build:express": "pnpm --filter express build",
    "build:socket": "pnpm --filter sockets build",
    "build:next": "pnpm --filter app-next build",
    "build": "pnpm build:domain && pnpm build:app && pnpm build:infra && pnpm build:next && pnpm build:socket && pnpm build:express",
    "lint": "pnpm -r lint",
    "mono-build": "pnpm tsc -b tsconfig.build.json",
    "mysql:seed": "pnpm --filter infrastructure run mysql:seed",
    "mysql:restart": "pnpm --filter infrastructure run mysql:restart",
    "mongo:seed": "pnpm --filter infrastructure run mongo:seed",
    "mongo:restart": "pnpm --filter infrastructure run mongo:restart",
    "socket": "pnpm --filter sockets run sockets",
    "express": "pnpm --filter express run express"
  },
  "workspaces": [
    "application",
    "domain",
    "infrastructure",
    "interfaces/*"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter interfaces/api/express dev",
    "dev:web": "pnpm --filter app-next dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",

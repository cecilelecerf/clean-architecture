{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "baseUrl": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "paths": {
      "@domain/*": ["domain/src/*"],
      "@application/*": ["application/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@api/*": ["interfaces/api/*"],
      "@web/*": ["interfaces/web/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

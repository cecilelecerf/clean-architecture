{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["./domain/src/*"],
      "@application/*": ["./application/src/*"],
      "@infrastructure/*": ["./infrastructure/src/*"],
      "@interfaces/*": ["./interfaces/*"]
    }
  }
}
